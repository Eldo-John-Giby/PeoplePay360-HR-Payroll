# --- Database ---
# Local dev (Postgres on host via docker compose db service):
DATABASE_URL=postgresql+psycopg2://peoplepay:peoplepay@localhost:5432/peoplepay
# Inside the docker compose app service this is overridden to:
#   postgresql+psycopg2://peoplepay:peoplepay@db:5432/peoplepay

# --- Auth / JWT ---
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080